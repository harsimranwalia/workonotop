DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root123
DB_NAME=workontap_db
DB_PORT=3306

# Stripe Country & Currency Configuration
STRIPE_COUNTRY=CA
STRIPE_CURRENCY=cad

# AI Gateway / ChatGPT / MCP Configuration
AI_GATEWAY_SECRET_KEY=generate-a-secure-random-token-here



# Session key (required): sign-in, sign-up and session checks refuse to run while it is unset or blank
JWT_SECRET=

# Texts and e-mails about a booking (ENG-018). Names only: the values belong to the host's own environment, never to this file.
# The public https origin that link texts are built from. In production a link text is refused (no_origin) while this is not an https URL.
NEXT_PUBLIC_APP_URL=
# Twilio, for every text. With any of the three unset a text is recorded as not_configured and nothing is sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# SMTP, for every e-mail (src/lib/email.js also reads EMAIL_USER and EMAIL_PASS in place of SMTP_USER and SMTP_PASS).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# The address that is told about an on-site report, beside the admin users' own addresses.
ADMIN_EMAIL=
